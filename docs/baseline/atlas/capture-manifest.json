{
  "schemaVersion": "1.0",
  "enabled": true,
  "autoCapture": true,
  "mode": "real-app",
  "outputDirectory": "docs/baseline/atlas/captures",
  "probe": {
    "command": [
      "powershell.exe",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/atlas-capture-probe.ps1"
    ],
    "timeoutMs": 15000
  },
  "versionSource": {
    "path": "apps/desktop/package.json",
    "field": "version"
  },
  "groups": [
    {
      "id": "island",
      "label": "灵动岛与功能页",
      "sources": [
        "apps/desktop/scripts/capture-ui.mjs",
        "apps/desktop/scripts/copy-vendor.mjs",
        "apps/desktop/scripts/electron-runtime.mjs",
        "apps/desktop/src/main/island.js",
        "apps/desktop/src/preload-island.js",
