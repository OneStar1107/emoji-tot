{
  "name": "@emojitot/desktop",
  "private": true,
  "version": "0.3.12",
  "description": "EmojiTot Studio as a desktop pet: a ball that sits on top of everything and answers to the emotion protocol",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "copy:vendor": "node scripts/copy-vendor.mjs",
    "prestart": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "prepack": "node scripts/copy-vendor.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "studio.emojitot.desktop",
    "productName": "EmojiTot",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "../../release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment"
    }
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^2.12.1"
  }
}
