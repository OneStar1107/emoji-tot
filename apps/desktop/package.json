{
  "name": "@emojitot/desktop",
  "private": true,
  "version": "0.3.51",
  "description": "EmojiTot Studio as a desktop pet: a ball that sits on top of everything and answers to the emotion protocol",
  "author": "OneStar1107",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "copy:vendor": "node scripts/copy-vendor.mjs",
    "prestart": "node scripts/copy-vendor.mjs",
    "start": "node scripts/electron-launch.mjs .",
    "dev": "node scripts/electron-launch.mjs . --dev",
    "prepack": "node scripts/copy-vendor.mjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/copy-vendor.mjs",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "studio.emojitot.desktop",
    "productName": "EmojiTot",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "src/main/services/*.ps1"
    ],
    "directories": {
      "output": "../../release"
    },
    "electronDownload": {
      "checksums": {
        "electron-v45.3.4-win32-x64.zip": "b177908b5c48dad990612d7861fc8f03f8c06be0ca3351383a83cc11dd8e9144"
      }
    },
    "nsis": {
      "artifactName": "EmojiTot.Setup.${version}.${ext}"
    },
    "portable": {
      "artifactName": "EmojiTot.${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  },
  "license": "MIT",
  "dependencies": {
    "imapflow": "^2.12.1"
  }
}
