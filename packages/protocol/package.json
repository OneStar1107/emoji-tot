  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aora-bot/engine": "0.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
