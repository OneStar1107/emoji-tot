{
  "name": "emoji-tot",
  "private": true,
  "version": "0.3.48",
  "description": "EmojiTot: an expressive character for the desktop and the web, driven by a two-digit protocol",
  "type": "commonjs",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @emojitot/core --filter @emojitot/protocol build",
    "dev": "pnpm --filter @emojitot/gallery dev",
    "desktop": "pnpm --filter @emojitot/desktop start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "preview": "pnpm build && node apps/gallery/scripts/preview.mjs",
    "dist": "pnpm build && pnpm --filter @emojitot/desktop dist",
    "check:gallery": "pnpm --filter @emojitot/gallery build && node apps/gallery/scripts/browser-check.mjs",
    "smoke:desktop": "pnpm --filter @emojitot/desktop copy:vendor && node apps/desktop/scripts/window-smoke.mjs",
    "audit:ci": "pnpm audit --registry=https://registry.npmjs.org --audit-level=moderate",
    "scan": "node scripts/scan-sensitive.mjs",
    "facts": "pnpm build && node scripts/facts.mjs",
    "docs:sync": "pnpm build && node scripts/sync-docs.mjs",
    "docs:check": "pnpm build && node scripts/sync-docs.mjs --check && node scripts/docs-consistency.mjs",
    "settings:audit": "node scripts/settings-audit.mjs",
    "settings:check": "node scripts/settings-audit.mjs --check",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm docs:check && pnpm settings:check && pnpm preview && pnpm check:gallery && pnpm smoke:desktop && pnpm audit:ci && pnpm scan"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
